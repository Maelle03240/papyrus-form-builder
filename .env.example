# =============================================================================
# Papyrus — variables d'environnement
#
# Ce fichier est un MODÈLE. Il ne doit jamais contenir de vraie valeur.
# Les valeurs réelles vivent dans Vaultwarden (collection « MOOOVE IT ») et sont
# saisies dans l'onglet Environment du service Easypanel — nulle part ailleurs.
#
# Pour le développement local : copier ce fichier en `.env.local` (gitignoré)
# et le remplir depuis Vaultwarden.
# =============================================================================

# --- Application ---------------------------------------------------------
# URL canonique. En production : https://papyrus.mooove.group
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (auto-hébergé, projet Easypanel `main` / service `supabase`) ---
# `anon` : côté navigateur, ne fonctionne que sur des tables avec RLS activée.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# `service_role` : contourne totalement la RLS. SERVEUR UNIQUEMENT.
# Ne jamais préfixer par NEXT_PUBLIC_, sous aucun prétexte.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 — images et vidéos ------------------------------------
# Règle Mooove : tous les médias vont sur R2, jamais sur Supabase Storage.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=mooove-media
R2_REGION=auto
R2_ACCESS_KEY_ID=
# SERVEUR UNIQUEMENT — sert à signer les URLs d'upload, jamais envoyé au navigateur.
R2_SECRET_ACCESS_KEY=
# Domaine public de lecture (CDN Cloudflare).
R2_PUBLIC_BASE_URL=https://media.mooove.ltd
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.mooove.ltd

# --- Chiffrement applicatif ----------------------------------------------
# Chiffre les secrets tiers stockés en base (clé API Tally d'une équipe).
# Générer avec : openssl rand -base64 32
# La changer rend illisibles les clés déjà enregistrées : elles devront être resaisies.
APP_ENCRYPTION_KEY=

# --- Confidentialité ------------------------------------------------------
# Sel du hachage d'IP des réponses. Sans lui, aucune IP n'est stockée.
# Générer avec : openssl rand -hex 16
IP_HASH_SALT=

# --- Intégrations optionnelles -------------------------------------------
# Emails transactionnels : invitations, notifications de réponse, accusés de
# réception. Absent = ces emails ne partent pas (le reste fonctionne).
RESEND_API_KEY=
# Adresse d'expédition des notifications. Doit appartenir à un domaine vérifié
# dans Resend, sinon tous les envois sont rejetés.
NOTIFICATION_FROM_EMAIL=notifications@notifications.mooove.group
# Génération de formulaire par IA. Absent = fonctionnalité désactivée proprement.
OPENROUTER_API_KEY=

# --- Google Sheets (OAuth 2.0) -------------------------------------------
# Identifiants d'un client OAuth « Application Web » créé dans la console Google
# Cloud, avec les API Google Sheets et Google Drive activées.
# Absent = l'onglet Intégrations affiche « non configuré », rien ne casse.
#
# Scopes demandés : openid, email, .../auth/spreadsheets, .../auth/drive.file.
# `drive.file` plutôt que `drive.readonly` : ce dernier est un scope restreint,
# qui imposerait une revue de sécurité annuelle par Google.
#
# L'URI de redirection doit être déclarée AU CARACTÈRE PRÈS dans la console
# Google, sinon l'échange du code est refusé :
#   https://papyrus.mooove.group/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optionnel — déduit de NEXT_PUBLIC_APP_URL si absent.
GOOGLE_REDIRECT_URI=
