  "feasibility": "degraded",
  "feasibility_note": {
    "fr": "Papyrus n’a ni groupe répétable ni champ calculé : une soumission correspond à une seule ligne de dépense et le total est saisi à la main — un champ `repeater` et un champ formule lèveraient la limite.",
    "en": "Papyrus has no repeating group and no calculated field, so one submission equals one expense line and the total is typed manually — a `repeater` field and a formula field would remove the limit."
  },
  "title": {
    "fr": "Note de frais",
    "en": "Expense claim"
  },
  "description": {
    "fr": "Une dépense par formulaire. Les demandes reçues avant le 25 du mois sont remboursées avec la paie du mois suivant.",
    "en": "One expense per form. Claims received before the 25th are reimbursed with the following month’s payroll."
  },
  "template_description": {
    "fr": "Collectez les notes de frais avec justificatif : catégorie, montant en roupies, code projet et pièce jointe.",
    "en": "Collect expense claims with proof: category, amount in rupees, project code and attached receipt."
  },
