  "description": {
    "fr": "Confirmez votre présence en trente secondes : accompagnants, régime et petit mot à l’hôte.",
    "en": "Confirm your attendance in thirty seconds: guests, dietary notes and a word to the host."
  },
  "template_description": {
    "fr": "Réponse en une question, puis seulement les détails utiles à ceux qui viennent.",
    "en": "One question to answer, then only the details that matter for those attending."
